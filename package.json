{
  "name": "tax-doc-classifier-au",
  "version": "0.2.0",
  "description": "Local Australian tax document review pilot with optional model classification",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/au/index.js",
  "types": "dist/au/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/au/index.js",
      "types": "./dist/au/index.d.ts"
    },
    "./data/criteria.json": "./data/criteria.json",
    "./au": {
      "import": "./dist/au/index.js",
      "types": "./dist/au/index.d.ts"
    },
    "./us": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data/criteria.json",
    "LICENSE",
    "DATA-LICENSE.md",
    "README.md",
    "scripts/extract-au.py",
    "!dist/**/*.test.*",
    "requirements-pdf.txt",
    "docs/upstream-readme.md",
    "scripts/extract-paddle.py",
    "requirements-paddle.txt",
    "docs/ocr-setup.md",
    "docs/evaluation.md",
    "docs/repository-comparison.md",
    "eval/au/results.json",
    "eval/au/README.md",
    "eval/au/ocr-probe.json",
    "eval/au/paddle-probe.json"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build-criteria": "tsx scripts/build-criteria.ts",
    "eval:download": "tsx eval/download.ts",
    "eval": "tsx eval/run.ts",
    "classify:au": "tsx src/au/cli.ts",
    "eval:au": "tsx eval/au/run.ts",
    "test:pdf": "tsx scripts/test-au-pdf.ts",
    "probe:ocr": "tsx scripts/probe-au-ocr.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "bin": {
    "tax-doc-au": "dist/au/cli.js"
  },
  "x-fork-notice": "Modified for the Australian classification pilot on 22 September 2026."
}
